@using Proyecto2026.Server.Client.Models

<div class="table-responsive-wrapper">
    <table class="table table-hover align-middle mb-0 saldos-table">
        <thead class="saldos-thead">
            <tr>
                <th scope="col" class="th-cliente">CLIENTE</th>
                <th scope="col" class="th-saldo text-end">SALDO PENDIENTE</th>
                <th scope="col" class="th-estado text-center">ESTADO</th>
                <th scope="col" class="th-acciones text-end">ACCIONES</th>
            </tr>
        </thead>
        <tbody>
            @if (Clientes.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center py-5">
                        @if (EstaFiltrado)
                        {
                            <div class="empty-state d-flex flex-column align-items-center justify-content-center p-4">
                                <div class="empty-state-icon bg-light text-secondary rounded-circle p-3 mb-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                                    </svg>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">Sin resultados de búsqueda</h5>
                                <p class="text-muted small mb-3">No se encontraron clientes que coincidan con el término ingresado.</p>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="OnLimpiarFiltro">
                                    Limpiar búsqueda
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state d-flex flex-column align-items-center justify-content-center p-4">
                                <div class="empty-state-icon bg-success-subtle text-success rounded-circle p-3 mb-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                                    </svg>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">¡No hay saldos pendientes!</h5>
                                <p class="text-muted small mb-0">Excelente, todos tus clientes se encuentran al día con sus pagos.</p>
                            </div>
                        }
                    </td>
                </tr>
            }
            else
            {
                @foreach (var cliente in Clientes)
                {
                    <SaldoRow @key="cliente.Id"
                              Cliente="@cliente"
                              OnRegistrarPago="@OnRegistrarPago" />
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<ClienteSaldoItem> Clientes { get; set; } = new();
    [Parameter] public EventCallback<ClienteSaldoItem> OnRegistrarPago { get; set; }
    [Parameter] public bool EstaFiltrado { get; set; } = false;
    [Parameter] public EventCallback OnLimpiarFiltro { get; set; }
}
