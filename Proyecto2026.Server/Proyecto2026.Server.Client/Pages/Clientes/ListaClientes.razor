@page "/clientes"
@inject HttpClient Http


<h3>ListaClientes</h3>


<p>@mensaje</p>

@code {

    private string mensaje = "";

    protected override async Task OnInitializedAsync() //ejecucion asincrona
    {
        try{
            mensaje = await Http.GetStringAsync("api/clientes");
        }
        catch(Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
    }







}
