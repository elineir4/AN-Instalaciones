        public string EmpleadoSubtitulo { get; set; } = string.Empty;
        public string TrabajoEtiqueta { get; set; } = string.Empty;
        public DateTime FechaPago { get; set; }
        public string MedioPago { get; set; } = string.Empty;
        public decimal Monto { get; set; }
    }

    private List<EmpleadoItem> listaEmpleados = new();
    private List<TrabajoApiItem> listaTrabajos = new();
    private List<PagoEmpleadoRow> listaPagos = new();

    private bool cargando = true;
    private string? errorCarga;

    // Filtros
    private string terminoBusqueda = "";
    private string terminoBusquedaDebounced = "";
    private string filtroMedioPago = "";
    private int filtroTrabajoId = 0;
    private System.Threading.Timer? debounceTimer;

    // Paginación
    private int paginaActual = 1;
    private const int ItemsPorPagina = 6;

    // Modal Registrar / Editar Pago
    private bool modalVisible = false;
    private bool esEdicion = false;
    private int pagoEditandoId = 0;
    private EmpleadoItem? empleadoSeleccionado;
    private int trabajoSeleccionadoId = 0;
    private decimal montoLiquidar = 0m;
    private string montoInputString = "";
    private string medioPago = "Efectivo";
    private DateTime fechaPago = DateTime.Today;
    private string fechaPagoString => fechaPago.ToString("yyyy-MM-dd");
    private string observaciones = "";
    private bool generarRecibo = true;
    private bool enviandoPago = false;
    private string? errorModal;

    // Modal Recibo
    private PagoEmpleadoRow? reciboSeleccionado;

    // Modal Eliminar
    private PagoEmpleadoRow? pagoAEliminar;
    private bool eliminandoPago = false;
    private string? errorEliminar;

    // Toast
    private bool toastVisible = false;
    private string toastTitulo = "Pago Registrado";
    private string toastMensaje = "";
    private System.Threading.Timer? toastTimer;

    private static readonly System.Globalization.CultureInfo CulturaArgentina = CrearCultura();

    private void RellenarRandomPago()
    {
        if (listaEmpleados.Count > 0)
            empleadoSeleccionado = listaEmpleados[Random.Shared.Next(listaEmpleados.Count)];

        if (listaTrabajos.Count > 0)
            trabajoSeleccionadoId = listaTrabajos[Random.Shared.Next(listaTrabajos.Count)].Id;

        var maxSalario = empleadoSeleccionado != null && empleadoSeleccionado.Salario > 0
            ? empleadoSeleccionado.Salario
            : 150000;
        var porcentajes = new[] { 0.25m, 0.5m, 0.75m, 1m };
        montoLiquidar = Math.Max(1000m, Math.Round(maxSalario * porcentajes[Random.Shared.Next(porcentajes.Length)], 0));
        if (empleadoSeleccionado != null && empleadoSeleccionado.Salario > 0 && montoLiquidar > empleadoSeleccionado.Salario)
            montoLiquidar = empleadoSeleccionado.Salario;

        montoInputString = montoLiquidar.ToString("0", System.Globalization.CultureInfo.InvariantCulture);
        medioPago = Random.Shared.Next(2) == 0 ? "Efectivo" : "Mercado Pago";
        fechaPago = DateTime.Today.AddDays(-Random.Shared.Next(0, 7));
        observaciones = $"Liquidación semanal #{Random.Shared.Next(1, 52)}";
        errorModal = null;
    }

    private static System.Globalization.CultureInfo CrearCultura()
    {
        var cultura = (System.Globalization.CultureInfo)System.Globalization.CultureInfo.GetCultureInfo("es-AR").Clone();
        cultura.NumberFormat.NumberGroupSeparator = ".";
        cultura.NumberFormat.NumberDecimalSeparator = ",";
        return cultura;
    }

    private static string FormatoMoneda(decimal monto) => "$ " + monto.ToString("N2", CulturaArgentina);

    private static string FormatearFecha(DateTime fecha) =>
        fecha == default ? "-" : fecha.ToString("dd/MM/yyyy");

    private decimal TotalPagadoSemana
    {
        get
        {
            var hoy = DateTime.Today;
            var diff = (7 + (hoy.DayOfWeek - DayOfWeek.Monday)) % 7;
            var inicioSemana = hoy.AddDays(-diff).Date;
            return listaPagos.Where(p => p.FechaPago.Date >= inicioSemana).Sum(p => p.Monto);
        }
    }

    private bool HayFiltroActivo =>
        !string.IsNullOrWhiteSpace(terminoBusquedaDebounced)
        || !string.IsNullOrWhiteSpace(filtroMedioPago)
        || filtroTrabajoId > 0;

    private List<PagoEmpleadoRow> PagosFiltrados
    {
        get
        {
            IEnumerable<PagoEmpleadoRow> query = listaPagos;

            if (!string.IsNullOrWhiteSpace(terminoBusquedaDebounced))
            {
                var q = FormatoMonedaHelper.RemoverTildes(terminoBusquedaDebounced.Trim());
                query = query.Where(p =>
                    FormatoMonedaHelper.RemoverTildes(p.EmpleadoNombre).Contains(q, StringComparison.OrdinalIgnoreCase)
                    || FormatoMonedaHelper.RemoverTildes(p.TrabajoEtiqueta).Contains(q, StringComparison.OrdinalIgnoreCase)
                    || FormatoMonedaHelper.RemoverTildes(p.MedioPago).Contains(q, StringComparison.OrdinalIgnoreCase)
                    || $"REC-{p.Id:D4}".Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(filtroMedioPago))
            {
                query = query.Where(p => p.MedioPago.Contains(filtroMedioPago, StringComparison.OrdinalIgnoreCase));
            }

            if (filtroTrabajoId > 0)
            {
                query = query.Where(p => p.TrabajoId == filtroTrabajoId);
            }

            return query.ToList();
        }
    }

    private int TotalPaginas
    {
        get
        {
            var total = (int)Math.Ceiling((double)PagosFiltrados.Count / ItemsPorPagina);
            return total < 1 ? 1 : total;
        }
    }

    private List<PagoEmpleadoRow> PagosPaginados =>
        PagosFiltrados
            .Skip((paginaActual - 1) * ItemsPorPagina)
            .Take(ItemsPorPagina)
            .ToList();

    private int InicioRangoPagina => PagosFiltrados.Count == 0 ? 0 : ((paginaActual - 1) * ItemsPorPagina) + 1;
    private int FinRangoPagina => Math.Min(paginaActual * ItemsPorPagina, PagosFiltrados.Count);

    private string? ErrorValidacionMonto
    {
        get
        {
            if (empleadoSeleccionado == null) return null;
            if (montoLiquidar <= 0) return "Ingrese un monto mayor a cero.";
            if (!esEdicion && empleadoSeleccionado.Salario > 0 && montoLiquidar > empleadoSeleccionado.Salario)
                return $"Atención: El monto supera el saldo adeudado ({FormatoMoneda(empleadoSeleccionado.Salario)}).";
            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!OperatingSystem.IsBrowser()) return;
        await CargarDatos(mostrarSpinner: true);
    }

    private async Task CargarDatos(bool mostrarSpinner = false)
    {
        if (mostrarSpinner)
        {
            cargando = true;
            errorCarga = null;
        }

        try
        {
            var respPagos = await Http.GetAsync<List<PagoEmpleadoApiItem>>("api/pagoempleado/lista");
            var respEmpleados = await Http.GetAsync<List<EmpleadoItem>>("api/empleados/lista");
            var respTrabajos = await Http.GetAsync<List<TrabajoApiItem>>("api/trabajos");

            if (respPagos.Error)
            {
                errorCarga = await HttpErrorHelper.ObtenerMensajeError(respPagos);
                return;
            }

            listaEmpleados = (!respEmpleados.Error && respEmpleados.Dato != null)
                ? respEmpleados.Dato.OrderBy(e => e.Apellido).ThenBy(e => e.Nombre).ToList()
                : new List<EmpleadoItem>();

            listaTrabajos = (!respTrabajos.Error && respTrabajos.Dato != null)
                ? respTrabajos.Dato.OrderByDescending(t => t.Id).ToList()
                : new List<TrabajoApiItem>();

            var empPorId = listaEmpleados.ToDictionary(e => e.Id);
            var trabPorId = listaTrabajos.ToDictionary(t => t.Id);

            var pagosRaw = respPagos.Dato ?? new List<PagoEmpleadoApiItem>();
            listaPagos = pagosRaw
                .OrderByDescending(p => p.FechaPago)
                .ThenByDescending(p => p.Id)
                .Select(p =>
                {
                    empPorId.TryGetValue(p.EmpleadoId, out var emp);
                    trabPorId.TryGetValue(p.TrabajoId ?? 0, out var trab);

                    return new PagoEmpleadoRow
                    {
                        Id = p.Id,
                        EmpleadoId = p.EmpleadoId,
                        TrabajoId = p.TrabajoId ?? 0,
                        EmpleadoNombre = emp?.NombreCompleto ?? $"Empleado #{p.EmpleadoId}",
                        EmpleadoSubtitulo = !string.IsNullOrWhiteSpace(emp?.Telefono) ? $"Tel: {emp.Telefono}" : "Operario de obra",
                        TrabajoEtiqueta = trab != null ? $"#TRB-{trab.Id} {trab.NombreObra}" : "General / Sin obra",
                        FechaPago = p.FechaPago,
                        MedioPago = string.IsNullOrWhiteSpace(p.MedioPago) ? "Efectivo" : p.MedioPago,
                        Monto = p.Monto
                    };
                })
                .ToList();

            if (paginaActual > TotalPaginas)
            {
                paginaActual = 1;
            }
        }
        catch (Exception ex)
        {
            errorCarga = $"Error de comunicación: {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void OnBusquedaInput(ChangeEventArgs e)
    {
        terminoBusqueda = e.Value?.ToString() ?? "";

        debounceTimer?.Dispose();
        debounceTimer = new System.Threading.Timer(async _ =>
        {
            terminoBusquedaDebounced = terminoBusqueda;
            paginaActual = 1;
            await InvokeAsync(StateHasChanged);
        }, null, 250, System.Threading.Timeout.Infinite);
    }

    private void OnMedioFilterChanged(ChangeEventArgs e)
    {
        filtroMedioPago = e.Value?.ToString() ?? "";
        paginaActual = 1;
    }

    private void OnTrabajoFilterChanged(ChangeEventArgs e)
    {
        filtroTrabajoId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        paginaActual = 1;
    }

    private void LimpiarFiltros()
    {
        terminoBusqueda = "";
        terminoBusquedaDebounced = "";
        filtroMedioPago = "";
        filtroTrabajoId = 0;
        paginaActual = 1;
    }

    private void CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || nuevaPagina > TotalPaginas) return;
        paginaActual = nuevaPagina;
    }

    private void AbrirModalNuevoPago()
    {
        var primero = listaEmpleados.FirstOrDefault(e => e.Salario > 0) ?? listaEmpleados.FirstOrDefault();
        if (primero == null) return;

        esEdicion = false;
        pagoEditandoId = 0;
        empleadoSeleccionado = primero;
        trabajoSeleccionadoId = listaTrabajos.FirstOrDefault()?.Id ?? 0;
        montoLiquidar = primero.Salario > 0 ? primero.Salario : 0m;
        montoInputString = montoLiquidar > 0 ? montoLiquidar.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "";
        medioPago = "Efectivo";
        fechaPago = DateTime.Today;
        observaciones = "";
        errorModal = null;
        enviandoPago = false;
        modalVisible = true;
    }

    private void AbrirModalEditarPago(PagoEmpleadoRow pago)
    {
        var emp = listaEmpleados.FirstOrDefault(e => e.Id == pago.EmpleadoId) ?? listaEmpleados.FirstOrDefault();
        if (emp == null) return;

        esEdicion = true;
        pagoEditandoId = pago.Id;
        empleadoSeleccionado = emp;
        trabajoSeleccionadoId = pago.TrabajoId > 0 ? pago.TrabajoId : 0;
        montoLiquidar = pago.Monto;
        montoInputString = pago.Monto.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        medioPago = pago.MedioPago;
        fechaPago = pago.FechaPago.Date;
        observaciones = "";
        errorModal = null;
        enviandoPago = false;
        modalVisible = true;
    }

    private void OnCambiarEmpleadoModal(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var encontrado = listaEmpleados.FirstOrDefault(x => x.Id == id);
            if (encontrado != null)
            {
                empleadoSeleccionado = encontrado;
                if (!esEdicion)
                {
                    montoLiquidar = encontrado.Salario > 0 ? encontrado.Salario : 0m;
                    montoInputString = montoLiquidar > 0 ? montoLiquidar.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "";
                }
                errorModal = null;
            }
        }
    }

    private void OnTrabajoModalChanged(ChangeEventArgs e)
    {
        trabajoSeleccionadoId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
    }

    private void LiquidarSaldoTotal()
    {
        if (empleadoSeleccionado == null) return;
        montoLiquidar = empleadoSeleccionado.Salario;
        montoInputString = empleadoSeleccionado.Salario.ToString("0", System.Globalization.CultureInfo.InvariantCulture);
        errorModal = null;
    }

    private void OnMontoInput(ChangeEventArgs e)
    {
        montoInputString = e.Value?.ToString() ?? "";
        errorModal = null;

        if (decimal.TryParse(montoInputString, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
        {
            montoLiquidar = parsed;
        }
        else if (decimal.TryParse(montoInputString, out var parsedLocal))
        {
            montoLiquidar = parsedLocal;
        }
        else
        {
            montoLiquidar = 0m;
        }
    }

    private void OnMedioPagoChanged(ChangeEventArgs e)
    {
        medioPago = e.Value?.ToString() ?? "Efectivo";
    }

    private void OnFechaPagoChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsed))
        {
            fechaPago = parsed;
        }
    }

    private void CerrarModal()
    {
        if (enviandoPago) return;
        modalVisible = false;
        empleadoSeleccionado = null;
        errorModal = null;
    }

    private async Task ConfirmarPago()
    {
        if (enviandoPago || empleadoSeleccionado == null || ErrorValidacionMonto != null) return;

        enviandoPago = true;
        errorModal = null;
        StateHasChanged();

        try
        {
            var operario = empleadoSeleccionado;
            var monto = montoLiquidar;
            var medio = medioPago;

            var dto = new PagoEmpleadoDTO
            {
                PagoEmpleadoId = esEdicion ? pagoEditandoId : 0,
                EmpleadoId = operario.Id,
                TrabajoId = trabajoSeleccionadoId > 0 ? trabajoSeleccionadoId : null,
                Monto = monto,
                FechaPago = fechaPago == DateTime.Today ? DateTime.Now : fechaPago,
                MedioPago = medio
            };

            if (esEdicion)
            {
                var resp = await Http.PutAsync<PagoEmpleadoDTO, object>($"api/pagoempleado/{pagoEditandoId}", dto);
                if (resp.Error)
                {
                    errorModal = await HttpErrorHelper.ObtenerMensajeError(resp);
                    return;
                }
            }
            else
            {
                var resp = await Http.PostAsync<PagoEmpleadoDTO, object>("api/pagoempleado/registrar", dto);
                if (resp.Error)
                {
                    errorModal = await HttpErrorHelper.ObtenerMensajeError(resp);
                    return;
                }
            }

            var mensajeToast = esEdicion
                ? $"Se actualizó el pago de {FormatoMoneda(monto)} para {operario.NombreCompleto}."
                : $"Se registró el pago de {FormatoMoneda(monto)} para {operario.NombreCompleto} ({medio}).";
            var tituloToast = esEdicion ? "Pago Actualizado" : "Pago Registrado";

            enviandoPago = false;
            CerrarModal();

            await CargarDatos(mostrarSpinner: false);
            MostrarToast(tituloToast, mensajeToast);
        }
        catch (Exception ex)
        {
            errorModal = $"Ocurrió un error al guardar el pago: {ex.Message}";
        }
        finally
        {
            enviandoPago = false;
            StateHasChanged();
        }
    }

    private void AbrirModalRecibo(PagoEmpleadoRow pago) => reciboSeleccionado = pago;
    private void CerrarRecibo() => reciboSeleccionado = null;

    private void AbrirModalEliminar(PagoEmpleadoRow pago)
    {
        pagoAEliminar = pago;
        errorEliminar = null;
    }

    private void CerrarEliminar()
    {
        if (eliminandoPago) return;
        pagoAEliminar = null;
        errorEliminar = null;
    }

    private async Task ConfirmarEliminar()
    {
        if (eliminandoPago || pagoAEliminar == null) return;

        eliminandoPago = true;
        errorEliminar = null;
        StateHasChanged();

        try
        {
            var resp = await Http.DeleteAsync<object>($"api/pagoempleado/{pagoAEliminar.Id}");
            if (resp.Error)
            {
                errorEliminar = await HttpErrorHelper.ObtenerMensajeError(resp);
                return;
            }

            var nombre = pagoAEliminar.EmpleadoNombre;
            var monto = pagoAEliminar.Monto;
            eliminandoPago = false;
            CerrarEliminar();

            await CargarDatos(mostrarSpinner: false);
            MostrarToast("Pago Eliminado", $"Se eliminó el registro de {FormatoMoneda(monto)} ({nombre}).");
        }
        catch (Exception ex)
        {
            errorEliminar = $"Error al eliminar: {ex.Message}";
        }
        finally
        {
            eliminandoPago = false;
            StateHasChanged();
        }
    }

    private void MostrarToast(string titulo, string mensaje)
    {
        toastTitulo = titulo;
        toastMensaje = mensaje;
        toastVisible = true;

        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(async _ =>
        {
            toastVisible = false;
            await InvokeAsync(StateHasChanged);
        }, null, 4500, System.Threading.Timeout.Infinite);
    }

    private static string ObtenerClaseTrabajo(int trabajoId)
    {
        if (trabajoId <= 0) return "pe2-work-neutral";
        return (trabajoId % 3) switch
        {
            0 => "pe2-work-emerald",
            1 => "pe2-work-indigo",
            _ => "pe2-work-blue"
        };
    }

    private static string ObtenerClaseMedio(string medio)
    {
        if (medio.Contains("Efectivo", StringComparison.OrdinalIgnoreCase)) return "pe2-medio-emerald";
        if (medio.Contains("Mercado", StringComparison.OrdinalIgnoreCase)) return "pe2-medio-sky";
        if (medio.Contains("Cheque", StringComparison.OrdinalIgnoreCase)) return "pe2-medio-amber";
        return "pe2-medio-blue";
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
        toastTimer?.Dispose();
    }
}
