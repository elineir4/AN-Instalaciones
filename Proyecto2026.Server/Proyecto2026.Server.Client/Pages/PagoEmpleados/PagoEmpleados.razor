@page "/pago-empleados"
@using Proyecto2026.Server.Client.Helpers
@using Proyecto2026.Server.Client.Models
@using Proyecto2026.Shared.DTO
@using Proyecto2026.Servicios.ServicioHTTP
@inject IHttpService Http
@implements IDisposable

<PageTitle>Pago de Empleados - AN Instalaciones</PageTitle>

<div class="pe-page">
    <!-- Encabezado -->
    <div class="pe-header">
        <div class="pe-header-left">
            <h1 class="pe2-title">Pago de Empleados</h1>
            <p class="pe2-subtitle">
                Registro y control de pagos y liquidaciones al personal - AN Instalaciones
            </p>
        </div>

        <div class="pe-header-actions">
            <button type="button"
                    class="pe2-btn-primary"
                    disabled="@(cargando || listaEmpleados.Count == 0)"
                    @onclick="AbrirModalNuevoPago">
                <span class="material-symbols-outlined" style="font-size: 19px;">add_card</span>
                <span>+ Registrar Pago</span>
            </button>
        </div>
    </div>

    <!-- 3 Tarjetas KPI -->
    <section class="pe2-kpi-grid">
        <!-- KPI 1: Total Pagado (Semana) -->
        <div class="pe2-kpi-card">
            <div>
                <span class="pe2-kpi-label">TOTAL PAGADO (SEMANA)</span>
                <div class="pe2-kpi-value">@(cargando ? "..." : FormatoMoneda(TotalPagadoSemana))</div>
            </div>
            <div class="pe2-kpi-icon pe2-kpi-icon-emerald">
                <span class="material-symbols-outlined">payments</span>
            </div>
        </div>

        <!-- KPI 2: Pagos Registrados -->
        <div class="pe2-kpi-card">
            <div>
                <span class="pe2-kpi-label">PAGOS REGISTRADOS</span>
                <div class="pe2-kpi-value">@(cargando ? "..." : listaPagos.Count.ToString())</div>
            </div>
            <div class="pe2-kpi-icon pe2-kpi-icon-blue">
                <span class="material-symbols-outlined">receipt_long</span>
            </div>
        </div>

        <!-- KPI 3: Empleados Activos -->
        <div class="pe2-kpi-card">
            <div>
                <span class="pe2-kpi-label">EMPLEADOS ACTIVOS</span>
                <div class="pe2-kpi-value">
                    @(cargando ? "..." : listaEmpleados.Count.ToString())
                    <span class="pe2-kpi-unit">operarios</span>
                </div>
            </div>
            <div class="pe2-kpi-icon pe2-kpi-icon-amber">
                <span class="material-symbols-outlined">group</span>
            </div>
        </div>
    </section>

    <!-- Estado de Error al cargar -->
    @if (!cargando && !string.IsNullOrWhiteSpace(errorCarga))
    {
        <div class="pe-error-card">
            <span class="material-symbols-outlined pe-text-error" style="font-size: 32px;">warning</span>
            <div class="flex-grow-1">
                <h6 class="fw-bold pe-text-error mb-1">Error al consultar los pagos</h6>
                <p class="text-muted small mb-2">@errorCarga</p>
                <button type="button" class="btn btn-danger btn-sm" @onclick="() => CargarDatos(mostrarSpinner: true)">
                    Reintentar
                </button>
            </div>
        </div>
    }

    <!-- Tabla y Filtros -->
    <section class="pe2-table-card">
        <!-- Barra de búsqueda y filtros -->
        <div class="pe2-toolbar">
            <div class="pe2-search-wrap">
                <span class="material-symbols-outlined pe2-search-icon">search</span>
                <input id="searchInput"
                       type="text"
                       class="pe2-search-input"
                       placeholder="Buscar por empleado, comprobante, obra..."
                       value="@terminoBusqueda"
                       @oninput="OnBusquedaInput" />
                @if (!string.IsNullOrWhiteSpace(terminoBusqueda))
                {
                    <button type="button"
                            class="pe2-clear-btn"
                            title="Limpiar búsqueda"
                            @onclick="LimpiarFiltros">
                        ✕
                    </button>
                }
            </div>

            <div class="pe2-filters-wrap">
                <span class="pe2-filter-label">Ver:</span>
                <select id="medioFilter"
                        aria-label="Filtrar por medio de pago"
                        class="pe2-select"
                        value="@filtroMedioPago"
                        @onchange="OnMedioFilterChanged">
                    <option value="">Todos los medios de pago</option>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Mercado Pago">Mercado Pago</option>
                </select>

                <select id="trabajoFilter"
                        aria-label="Filtrar por trabajo"
                        class="pe2-select"
                        value="@filtroTrabajoId"
                        @onchange="OnTrabajoFilterChanged">
                    <option value="0">Todos los trabajos</option>
                    @foreach (var trab in listaTrabajos)
                    {
                        <option value="@trab.Id">#TRB-@trab.Id @trab.NombreObra</option>
                    }
                </select>
            </div>
        </div>

        <!-- Contenido de la tabla -->
        @if (cargando)
        {
            <div class="p-5 text-center">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="text-secondary small fw-medium">Cargando pagos de empleados...</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="pe2-table" id="pagosEmpleadosTable">
                    <thead>
                        <tr>
                            <th>EMPLEADO</th>
                            <th>TRABAJO / OBRA</th>
                            <th class="text-center">FECHA PAGO</th>
                            <th class="text-center">MEDIO DE PAGO</th>
                            <th class="text-end">MONTO</th>
                            <th class="text-center">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PagosFiltrados.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="d-flex flex-column align-items-center justify-content-center p-3">
                                        <span class="material-symbols-outlined text-secondary mb-2" style="font-size: 36px;">receipt_long</span>
                                        <h6 class="fw-bold text-dark mb-1">No se encontraron pagos registrados</h6>
                                        <p class="text-muted small mb-3">
                                            @(HayFiltroActivo
                                                ? "No hay pagos que coincidan con los filtros seleccionados."
                                                : "Todavía no hay pagos registrados para empleados. Usa \"+ Registrar Pago\" para crear uno.")
                                        </p>
                                        @if (HayFiltroActivo)
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LimpiarFiltros">
                                                Limpiar filtros
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var pago in PagosPaginados)
                            {
                                <tr class="pe2-row" @key="pago.Id">
                                    <td>
                                        <div class="pe2-emp-name">@pago.EmpleadoNombre</div>
                                        <div class="pe2-emp-sub">@pago.EmpleadoSubtitulo</div>
                                    </td>
                                    <td>
                                        <span class="pe2-work-badge @ObtenerClaseTrabajo(pago.TrabajoId)">
                                            @pago.TrabajoEtiqueta
                                        </span>
                                    </td>
                                    <td class="text-center pe2-date-cell">
                                        @pago.FechaPago.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-center">
                                        <span class="pe2-medio-pill @ObtenerClaseMedio(pago.MedioPago)">
                                            @pago.MedioPago
                                        </span>
                                    </td>
                                    <td class="text-end pe2-amount-cell">
                                        @FormatoMoneda(pago.Monto)
                                    </td>
                                    <td class="text-center">
                                        <div class="pe2-actions-cell">
                                            <button type="button"
                                                    class="pe2-icon-btn"
                                                    title="Ver Recibo"
                                                    @onclick="() => AbrirModalRecibo(pago)">
                                                <span class="material-symbols-outlined">receipt</span>
                                            </button>
                                            <button type="button"
                                                    class="pe2-icon-btn"
                                                    title="Editar Pago"
                                                    @onclick="() => AbrirModalEditarPago(pago)">
                                                <span class="material-symbols-outlined">edit</span>
                                            </button>
                                            <button type="button"
                                                    class="pe2-icon-btn pe2-icon-btn-danger"
                                                    title="Eliminar Registro"
                                                    @onclick="() => AbrirModalEliminar(pago)">
                                                <span class="material-symbols-outlined">delete</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer Paginación -->
            <div class="pe2-footer">
                <div class="pe2-footer-info">
                    Mostrando <strong>@InicioRangoPagina</strong> a <strong>@FinRangoPagina</strong> de <strong>@PagosFiltrados.Count</strong> pagos registrados
                </div>
                <div class="pe2-pagination">
                    <button type="button"
                            class="pe2-page-btn pe2-page-nav"
                            disabled="@(paginaActual <= 1)"
                            @onclick="() => CambiarPagina(paginaActual - 1)">
                        Anterior
                    </button>
                    @for (int i = 1; i <= TotalPaginas; i++)
                    {
                        var num = i;
                        <button type="button"
                                class="pe2-page-btn @(paginaActual == num ? "active" : "")"
                                @onclick="() => CambiarPagina(num)">
                            @num
                        </button>
                    }
                    <button type="button"
                            class="pe2-page-btn pe2-page-nav"
                            disabled="@(paginaActual >= TotalPaginas)"
                            @onclick="() => CambiarPagina(paginaActual + 1)">
                        Siguiente
                    </button>
                </div>
            </div>
        }
    </section>

    <!-- CAJA INDIVIDUAL: REGISTRAR / EDITAR PAGO A EMPLEADO (Mantiene opciones y diseño actual) -->
    @if (modalVisible && empleadoSeleccionado != null)
    {
        <div class="pe-modal-backdrop" @onclick="CerrarModal">
            <div class="pe-modal-card" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="tituloModalPagoEmpleado">
                <!-- Modal Header -->
                <div class="pe-modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="pe-modal-header-icon">
                            <span class="material-symbols-outlined" style="font-size: 20px;">payments</span>
                        </div>
                        <div class="d-flex flex-column">
                            <h2 class="pe-modal-title" id="tituloModalPagoEmpleado">
                                @(esEdicion ? "Editar Pago a Empleado" : "Registrar Pago a Empleado")
                            </h2>
                            <span class="pe-modal-subtitle">
                                @(esEdicion ? $"Modificando comprobante #REC-{pagoEditandoId:D4}" : "Emisión de comprobante de nómina de obra")
                            </span>
                        </div>
                    </div>
                    <button type="button" class="pe-modal-close" @onclick="CerrarModal" disabled="@enviandoPago" aria-label="Cerrar">
                        <span class="material-symbols-outlined" style="font-size: 22px;">close</span>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="pe-modal-body">
                    @if (!string.IsNullOrWhiteSpace(errorModal))
                    {
                        <div class="pe-alert-error">
                            <span class="material-symbols-outlined" style="font-size: 18px;">error</span>
                            <span>@errorModal</span>
                        </div>
                    }

                    @if (listaEmpleados.Count > 1)
                    {
                        <div class="d-flex flex-column gap-1">
                            <label class="pe-label" for="selectOperarioModal">Seleccionar Operario</label>
                            <select id="selectOperarioModal"
                                    class="pe-select"
                                    value="@empleadoSeleccionado.Id"
                                    @onchange="OnCambiarEmpleadoModal"
                                    disabled="@enviandoPago">
                                @foreach (var emp in listaEmpleados)
                                {
                                    <option value="@emp.Id">@emp.NombreCompleto — Salario: @FormatoMoneda(emp.Salario)</option>
                                }
                            </select>
                        </div>
                    }

                    <!-- Operario / Titular Summary Card -->
                    <div class="d-flex flex-column gap-1">
                        <label class="pe-label">Operario / Titular</label>
                        <div class="pe-operario-box">
                            <div class="d-flex align-items-center gap-2">
                                <div class="pe-operario-avatar">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">person</span>
                                </div>
                                <div class="d-flex flex-column">
                                    <span class="pe-operario-name">@empleadoSeleccionado.NombreCompleto</span>
                                    <span class="pe-emp-sub">Ingreso @FormatearFecha(empleadoSeleccionado.FechaIngreso)</span>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="pe-emp-sub d-block">Saldo / Salario</span>
                                <span class="pe-operario-saldo">@FormatoMoneda(empleadoSeleccionado.Salario)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Trabajo / Obra -->
                    <div class="d-flex flex-column gap-1">
                        <label class="pe-label" for="selectTrabajoModal">Trabajo / Obra (opcional)</label>
                        <select id="selectTrabajoModal"
                                class="pe-select"
                                value="@trabajoSeleccionadoId"
                                @onchange="OnTrabajoModalChanged"
                                disabled="@enviandoPago">
                            <option value="0">General / Sin obra asignada</option>
                            @foreach (var trab in listaTrabajos)
                            {
                                <option value="@trab.Id">#TRB-@trab.Id — @trab.NombreObra</option>
                            }
                        </select>
                    </div>

                    <!-- Monto a Liquidar -->
                    <div class="d-flex flex-column gap-1">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="pe-label" for="paymentAmount">Monto a Liquidar</label>
                            <button type="button"
                                    class="pe-btn-link"
                                    @onclick="LiquidarSaldoTotal"
                                    disabled="@(enviandoPago || empleadoSeleccionado.Salario <= 0)">
                                Liquidar Saldo Total
                            </button>
                        </div>
                        <div class="pe-amount-wrapper">
                            <span class="pe-amount-prefix">$</span>
                            <input id="paymentAmount"
                                   type="number"
                                   step="100"
                                   min="1"
                                   max="@(empleadoSeleccionado.Salario > 0 ? empleadoSeleccionado.Salario : decimal.MaxValue)"
                                   class="pe-amount-input @(ErrorValidacionMonto != null ? "invalid" : "")"
                                   placeholder="0.00"
                                   value="@montoInputString"
                                   @oninput="OnMontoInput"
                                   disabled="@enviandoPago" />
                            <span class="pe-amount-suffix">ARS</span>
                        </div>
                        @if (ErrorValidacionMonto != null)
                        {
                            <span class="pe-help-text pe-text-error">@ErrorValidacionMonto</span>
                        }
                        else if (empleadoSeleccionado.Salario > 0)
                        {
                            <span class="pe-help-text">
                                El monto no puede superar el saldo pendiente (<strong>@FormatoMoneda(empleadoSeleccionado.Salario)</strong>)
                            </span>
                        }
                    </div>

                    <!-- Medio de Pago & Fecha de Pago -->
                    <div class="row g-3">
                        <div class="col-12 col-sm-6 d-flex flex-column gap-1">
                            <label class="pe-label" for="medioPago">Medio de Pago</label>
                            <select id="medioPago"
                                    class="pe-select"
                                    value="@medioPago"
                                    @onchange="OnMedioPagoChanged"
                                    disabled="@enviandoPago">
                                <option value="Efectivo">Efectivo</option>
                                <option value="Mercado Pago">Mercado Pago</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 d-flex flex-column gap-1">
                            <label class="pe-label" for="fechaPago">Fecha de Pago</label>
                            <input id="fechaPago"
                                   type="date"
                                   class="pe-input"
                                   value="@fechaPagoString"
                                   @onchange="OnFechaPagoChanged"
                                   disabled="@enviandoPago" />
                        </div>
                    </div>

                    <!-- Concepto de Obra / Observaciones -->
                    <div class="d-flex flex-column gap-1">
                        <label class="pe-label" for="observaciones">Concepto de Obra / Observaciones</label>
                        <input id="observaciones"
                               type="text"
                               class="pe-input"
                               placeholder="Ej. Semana 12 - Obra Central..."
                               @bind="observaciones"
                               disabled="@enviandoPago" />
                    </div>

                    <!-- Checkbox Recibo -->
                    <div class="pe-recibo-box">
                        <input id="chkRecibo"
                               type="checkbox"
                               class="pe-checkbox"
                               @bind="generarRecibo"
                               disabled="@enviandoPago" />
                        <label class="pe-recibo-label" for="chkRecibo">
                            Generar recibo provisorio PDF y enviar notificación de pago vía SMS / WhatsApp al operario.
                        </label>
                    </div>

                    <!-- Acciones del Modal -->
                    <div class="pe-modal-actions d-flex justify-content-between align-items-center">
                        <button type="button"
                                class="pe-btn-cancel"
                                @onclick="RellenarRandomPago"
                                disabled="@enviandoPago"
                                title="Completar con datos aleatorios de prueba">
                            Rellenar automáticamente
                        </button>
                        <div class="d-flex gap-2">
                            <button type="button"
                                    class="pe-btn-cancel"
                                    @onclick="CerrarModal"
                                    disabled="@enviandoPago">
                                Cancelar
                            </button>
                            <button type="button"
                                    id="submitPaymentBtn"
                                    class="pe-btn-confirm"
                                    disabled="@(enviandoPago || ErrorValidacionMonto != null || montoLiquidar <= 0)"
                                    @onclick="ConfirmarPago">
                            @if (enviandoPago)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size: 18px;">check_circle</span>
                                <span>@(esEdicion ? "Guardar Cambios" : "Confirmar Pago")</span>
                            }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- MODAL: VER RECIBO -->
    @if (reciboSeleccionado != null)
    {
        <div class="pe-modal-backdrop" @onclick="CerrarRecibo">
            <div class="pe-modal-card" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                <div class="pe-modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="pe-modal-header-icon">
                            <span class="material-symbols-outlined" style="font-size: 20px;">receipt</span>
                        </div>
                        <div class="d-flex flex-column">
                            <h2 class="pe-modal-title">Comprobante #REC-@reciboSeleccionado.Id.ToString("D4")</h2>
                            <span class="pe-modal-subtitle">AN Instalaciones - Liquidación de Operario</span>
                        </div>
                    </div>
                    <button type="button" class="pe-modal-close" @onclick="CerrarRecibo" aria-label="Cerrar">
                        <span class="material-symbols-outlined" style="font-size: 22px;">close</span>
                    </button>
                </div>
                <div class="pe-modal-body">
                    <div class="pe2-recibo-grid">
                        <div class="pe2-recibo-row">
                            <span class="pe2-recibo-key">Empleado</span>
                            <span class="pe2-recibo-val">@reciboSeleccionado.EmpleadoNombre</span>
                        </div>
                        <div class="pe2-recibo-row">
                            <span class="pe2-recibo-key">Trabajo / Obra</span>
                            <span class="pe2-recibo-val">@reciboSeleccionado.TrabajoEtiqueta</span>
                        </div>
                        <div class="pe2-recibo-row">
                            <span class="pe2-recibo-key">Fecha de Pago</span>
                            <span class="pe2-recibo-val">@reciboSeleccionado.FechaPago.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="pe2-recibo-row">
                            <span class="pe2-recibo-key">Medio de Pago</span>
                            <span class="pe2-recibo-val">@reciboSeleccionado.MedioPago</span>
                        </div>
                        <div class="pe2-recibo-row pe2-recibo-total">
                            <span class="pe2-recibo-key">Monto Abonado</span>
                            <span class="pe2-recibo-amount">@FormatoMoneda(reciboSeleccionado.Monto)</span>
                        </div>
                    </div>
                    <div class="pe-modal-actions">
                        <button type="button" class="pe-btn-cancel" @onclick="CerrarRecibo">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- MODAL: ELIMINAR REGISTRO -->
    @if (pagoAEliminar != null)
    {
        <div class="pe-modal-backdrop" @onclick="CerrarEliminar">
            <div class="pe-modal-card" style="max-width: 440px;" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                <div class="pe-modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="pe-modal-header-icon" style="background-color: #FEE2E2; color: #DC2626;">
                            <span class="material-symbols-outlined" style="font-size: 20px;">delete</span>
                        </div>
                        <div class="d-flex flex-column">
                            <h2 class="pe-modal-title">Eliminar Registro de Pago</h2>
                            <span class="pe-modal-subtitle">Esta acción no se puede deshacer</span>
                        </div>
                    </div>
                    <button type="button" class="pe-modal-close" @onclick="CerrarEliminar" disabled="@eliminandoPago" aria-label="Cerrar">
                        <span class="material-symbols-outlined" style="font-size: 22px;">close</span>
                    </button>
                </div>
                <div class="pe-modal-body">
                    <p class="mb-2" style="font-size: 0.9rem; color: #334155;">
                        ¿Seguro que deseas eliminar el pago de <strong>@FormatoMoneda(pagoAEliminar.Monto)</strong> registrado para
                        <strong>@pagoAEliminar.EmpleadoNombre</strong> el <strong>@pagoAEliminar.FechaPago.ToString("dd/MM/yyyy")</strong>?
                    </p>
                    @if (!string.IsNullOrWhiteSpace(errorEliminar))
                    {
                        <div class="pe-alert-error">
                            <span class="material-symbols-outlined" style="font-size: 18px;">error</span>
                            <span>@errorEliminar</span>
                        </div>
                    }
                    <div class="pe-modal-actions">
                        <button type="button" class="pe-btn-cancel" @onclick="CerrarEliminar" disabled="@eliminandoPago">Cancelar</button>
                        <button type="button"
                                class="pe2-btn-danger"
                                disabled="@eliminandoPago"
                                @onclick="ConfirmarEliminar">
                            @(eliminandoPago ? "Eliminando..." : "Eliminar")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Toast de Confirmación -->
    @if (toastVisible)
    {
        <div class="pe-toast" role="status" aria-live="polite">
            <div class="pe-toast-icon">
                <span class="material-symbols-outlined" style="font-size: 20px;">done</span>
            </div>
            <div class="d-flex flex-column">
                <span class="pe-toast-title">@toastTitulo</span>
                <span class="pe-toast-msg">@toastMensaje</span>
            </div>
        </div>
    }
</div>

@code {
    private class PagoEmpleadoApiItem
    {
        public int Id { get; set; }
        public int EmpleadoId { get; set; }
        public int? TrabajoId { get; set; }
        public decimal Monto { get; set; }
        public DateTime FechaPago { get; set; }
        public string MedioPago { get; set; } = string.Empty;
    }

