@page "/"

<PageTitle>Inicio - AN Instalaciones</PageTitle>

<div class="home-container">
    <!-- Encabezado -->
    <header class="home-header">
        <h1 class="home-title">Hola, Antonio</h1>
        <p class="home-subtitle">Resumen de AN Instalaciones - Sanitarias y Gas</p>
    </header>

    <!-- Accesos rápidos -->
    <section class="home-quick-grid" aria-label="Accesos rápidos">
        <a class="quick-card" href="/clientes">
            <span class="quick-card-icon" aria-hidden="true"><span class="bi bi-people-fill"></span></span>
            <span class="quick-card-title">Clientes</span>
            <span class="quick-card-desc">Gestioná los datos de tus clientes</span>
        </a>

        <a class="quick-card" href="/empleados">
            <span class="quick-card-icon" aria-hidden="true"><span class="bi bi-person-badge-fill"></span></span>
            <span class="quick-card-title">Empleados</span>
            <span class="quick-card-desc">Administrá el personal de obra</span>
        </a>

        <a class="quick-card" href="/pagos">
            <span class="quick-card-icon" aria-hidden="true"><span class="bi bi-wallet2"></span></span>
            <span class="quick-card-title">Pagos</span>
            <span class="quick-card-desc">Controlá saldos y registrá pagos</span>
        </a>
    </section>
</div>
