@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="main-content">
        <header class="topbar">
            <div class="topbar-left">
                <div class="search-box">
                    <span class="material-symbols-outlined search-icon">search</span>
                    <input type="text"
                           class="search-input"
                           placeholder="Buscar obras, remitos, técnicos..."
                           aria-label="Buscar obras, remitos, técnicos..." />
                </div>
            </div>

            <div class="topbar-right">
                <div class="user-block">
                    <div class="user-details text-end">
                        <span class="user-name">ANTONIO</span>
                        <span class="user-role">Jefe de Obra</span>
                    </div>
                    <div class="user-avatar" title="ANTONIO - Jefe de Obra">
                        <span class="material-symbols-outlined fs-5">person</span>
                    </div>
                </div>
            </div>
        </header>

        <article class="content">
            @Body
        </article>
    </main>
</div>
